{
  "name": "flare-hub-agency-console",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "build": "tsc -p tsconfig.app.json && vite build && node scripts/create-sites-worker.mjs",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:permissions": "vitest run src/security/access.test.ts",
    "test:auth-session": "vitest run src/security/access.test.ts",
    "test:runtime-reads": "vitest run src/security/access.test.ts",
    "test:runtime-writes": "vitest run src/security/access.test.ts",
    "test:rules": "vitest run src/security/firestoreRules.test.ts",
    "test:domain": "vitest run src/domain/domain.test.ts",
    "qa:source": "node scripts/source-qa.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.0.0",
    "typescript-eslint": "^8.64.0",
    "vitest": "^3.2.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
